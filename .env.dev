# API host. No trailing slash — ApiUrls appends "/api" itself.
API_BASE_URL=http://crm.nimmysonline.com

# Appended straight onto API_BASE_URL by EnvironmentVariables._formatBaseUrl.
# Leave empty unless the host needs an explicit port (e.g. ":8000").
PORT=

# Optional. The CRM API is not behind HTTP basic auth, so these stay empty and
# ApiService omits the Authorization header. Fill both in if that ever changes.
API_BASIC_AUTH_USERNAME=
API_BASIC_AUTH_PASSWORD=
